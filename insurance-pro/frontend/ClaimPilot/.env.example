# ClaimPilot integrated frontend configuration.
# The frontend calls FastAPI; it does not connect directly to Supabase.
# Local development:
VITE_API_BASE_URL="http://localhost:8000/api/v1"
VITE_CUSTOMER_EXTENDVIEW_URL="http://localhost:8501"
VITE_AGENT_EXTENDVIEW_URL="http://localhost:8502"
# Deployment: set VITE_API_BASE_URL to the hosted backend HTTPS URL ending in /api/v1,
# and VITE_CUSTOMER_EXTENDVIEW_URL / VITE_AGENT_EXTENDVIEW_URL to the hosted ExtendView services.
# Never place service-role keys, JWT signing secrets, or email-provider secrets in Vite variables.
