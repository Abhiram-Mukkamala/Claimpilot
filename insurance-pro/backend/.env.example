# ══════════════════════════════════════════════════════
# ClaimPilot Backend Environment Configuration (.env.example)
# Copy this file to .env and fill in the required values.
# ══════════════════════════════════════════════════════

# ── Required Supabase Credentials (backend only) ─────
# Verified ClaimPilot project, Mumbai region. Never put the service-role key in Vite variables.
SUPABASE_URL="https://zegygoxpmnxpdhutdpqf.supabase.co"
SUPABASE_ANON_KEY="your-supabase-anon-key"
SUPABASE_SERVICE_ROLE_KEY="your-supabase-service-role-key"
SUPABASE_STORAGE_BUCKET="claim-evidence"

# ── Required JWT Configuration ────────────────────────
JWT_SECRET="your-secure-random-secret-minimum-32-chars"
JWT_ALGORITHM="HS256"
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Runtime mode. Production requires a real OTP delivery provider.
ENVIRONMENT=development
# Optional local-only fixed OTP; set only for local development, never staging/production.
# OTP_DEV_FIXED_CODE=123456

# ── Frontend & CORS ──────────────────────────────────
FRONTEND_URL="http://localhost:5173"
ALLOWED_ORIGINS="http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173"

# ── Optional Indicative Cost Estimator ────────────────
# Geometry/table-derived only; requires calibration before insurer-grade use.
COST_ESTIMATOR_MIN_CONFIDENCE=0.30
COST_SEVERITY_MINOR_MAX_AREA_RATIO=0.02
COST_SEVERITY_MODERATE_MAX_AREA_RATIO=0.08
COST_DUPLICATE_IOU_THRESHOLD=0.80

# ── Optional Fraud Detection Engine ───────────────────
PHASH_DISTANCE_THRESHOLD=5
FRAUD_LLM_PROVIDER="openai"
FRAUD_LLM_API_KEY=""
FRAUD_LLM_MODEL="gpt-4o-mini"

# ── Active Email Delivery: SendGrid ──────────────────
# Both values are required for email OTP delivery outside local fixed-code mode.
SENDGRID_API_KEY=""
SENDGRID_FROM_EMAIL=""

# Legacy SMTP settings below are retained for compatibility; current email dispatch uses SendGrid.
SMTP_HOST="smtp.example.com"
SMTP_PORT=587
SMTP_USER="apikey"
SMTP_PASSWORD="your-smtp-password"
SMTP_FROM_EMAIL="notifications@claimpilot.com"
SMTP_FROM_NAME="ClaimPilot Claims Engine"
SUPPORT_EMAIL="support@claimpilot.com"

# ── Optional SMS Configuration (Twilio / Fast2SMS) ───
TWILIO_ACCOUNT_SID=""
TWILIO_AUTH_TOKEN=""
TWILIO_PHONE_NUMBER=""
TWILIO_VERIFY_SERVICE_SID=""
FAST2SMS_API_KEY=""
