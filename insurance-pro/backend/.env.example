# ══════════════════════════════════════════════════════
# ClaimPilot Backend Environment Configuration (.env.example)
# Copy this file to .env and fill in the required values.
# ══════════════════════════════════════════════════════

# ── Required Supabase Credentials ─────────────────────
SUPABASE_URL="https://your-project-ref.supabase.co"
SUPABASE_ANON_KEY="your-supabase-anon-key"
SUPABASE_SERVICE_ROLE_KEY="your-supabase-service-role-key"
SUPABASE_STORAGE_BUCKET="claim-evidence"

# ── Required JWT Configuration ────────────────────────
JWT_SECRET="your-secure-random-secret-minimum-32-chars"
JWT_ALGORITHM="HS256"
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=1440

# ── Frontend & CORS ──────────────────────────────────
FRONTEND_URL="http://localhost:5173"
ALLOWED_ORIGINS="http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173"

# ── Optional Indicative Cost Estimator ────────────────
# Geometry/table-derived only; requires calibration before insurer-grade use.
COST_ESTIMATOR_MIN_CONFIDENCE=0.30
COST_SEVERITY_MINOR_MAX_AREA_RATIO=0.02
COST_SEVERITY_MODERATE_MAX_AREA_RATIO=0.08
COST_DUPLICATE_IOU_THRESHOLD=0.80

# ── Optional Fraud Detection Engine ───────────────────
PHASH_DISTANCE_THRESHOLD=5
FRAUD_LLM_PROVIDER="openai"
FRAUD_LLM_API_KEY=""
FRAUD_LLM_MODEL="gpt-4o-mini"

# ── Optional Email Configuration (SMTP / SendGrid) ───
SMTP_HOST="smtp.example.com"
SMTP_PORT=587
SMTP_USER="apikey"
SMTP_PASSWORD="your-smtp-password"
SMTP_FROM_EMAIL="notifications@claimpilot.com"
SMTP_FROM_NAME="ClaimPilot Claims Engine"
SUPPORT_EMAIL="support@claimpilot.com"
SENDGRID_API_KEY=""
SENDGRID_FROM_EMAIL=""

# ── Optional SMS Configuration (Twilio / Fast2SMS) ───
TWILIO_ACCOUNT_SID=""
TWILIO_AUTH_TOKEN=""
TWILIO_PHONE_NUMBER=""
FAST2SMS_API_KEY=""
